    {
        "id": "62b2bca050942cac",
        "type": "function",
        "z": "6139ca60410f6a16",
        "name": "Store Variables",
        "func": "// Store variables kp, ki, kd\nif (msg.payload && msg.payload.type === \"pid_config\") {\n    if (msg.payload.kp !== undefined) flow.set(\"kp\", Number(msg.payload.kp));\n    if (msg.payload.ki !== undefined) flow.set(\"ki\", Number(msg.payload.ki));\n    if (msg.payload.kd !== undefined) flow.set(\"kd\", Number(msg.payload.kd));\n    if (msg.payload.setpoint !== undefined) flow.set(\"setpoint\", Number(msg.payload.setpoint));\n\n    node.status({ fill: \"green\", shape: \"dot\", text: \"Settings Updated\" });\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 620,
        "wires": [
            []
        ]
    },
    {
        "id": "20342c98bb37b546",
        "type": "function",
        "z": "6139ca60410f6a16",
        "name": "Calculate PID",
        "func": "// Calculate PID Output\nconst kp = flow.get(\"kp\") ?? 0.0;\nconst ki = flow.get(\"ki\") ?? 0.0;\nconst kd = flow.get(\"kd\") ?? 0.0;\nconst setpoint = flow.get(\"setpoint\") ?? 0.0;\n\n// Parse\nlet payload = msg.payload;\nif (typeof payload === \"string\") {\n  try { payload = JSON.parse(payload); } catch(e) { return null; }\n}\nconst pv = Number(payload?.processVariable);\nif (isNaN(pv)) return null;\n\n// Time\nlet integral = flow.get(\"integral\") ?? 0;\nlet lastError = flow.get(\"lastError\") ?? 0;\nlet lastTime = flow.get(\"lastTime\") ?? Date.now();\nconst now = Date.now();\n\nlet dt = (now - lastTime) / 1000.0;\nif (dt <= 0 || isNaN(dt)) dt = 1.0;\n\n// PID Calculation\nconst error = setpoint - pv;\nintegral += error * dt;\nintegral = Math.max(-500, Math.min(500, integral)); //Anti-windup\nconst derivative = (error - lastError) / dt;\nlet output = (kp * error) + (ki * integral) + (kd * derivative);\noutput = Math.max(0, Math.min(100, output)); \n\n// Update \nflow.set(\"integral\", integral);\nflow.set(\"lastError\", error);\nflow.set(\"lastTime\", now);\n\n// Output \nconst msgESP = { payload: { controlValue: Number(output.toFixed(2)) } };\nconst msgUI = { \n  payload: { \n    controlValue: Number(output.toFixed(2)), \n    processVariable: pv, \n    setpoint: setpoint \n  } \n};\n\nreturn [msgESP, msgUI];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
